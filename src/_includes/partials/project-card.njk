<article class="card flex flex-col h-full">
  <a href="{{ post.url }}" class="block overflow-hidden rounded-t-3xl">
    {% if post.data.bild %}
      <img
        src="{{ post.data.bild }}"
        alt="{{ post.data.title }}"
        class="w-full h-48 object-cover transition-transform duration-300 hover:scale-105"
        onerror="this.src='/assets/images/logo.svg'; this.classList.add('object-contain','p-8','bg-amber/20')"
      />
    {% else %}
      <div class="w-full h-48 bg-amber/20 flex items-center justify-center">
        <img src="/assets/images/logo.svg" alt="Platzhalter" class="w-20 h-20 opacity-50" />
      </div>
    {% endif %}
  </a>
  <div class="card-inner flex flex-col flex-1">
    <time class="text-xs font-semibold text-terra uppercase tracking-wider mb-2" datetime="{{ post.date | dateISO }}">
      {{ post.date | dateFormat }}
    </time>
    <h3 class="text-lg font-bold mb-2 leading-snug">
      <a href="{{ post.url }}" class="hover:text-terra no-underline text-brown">{{ post.data.title }}</a>
    </h3>
    <p class="text-brown/70 text-sm line-clamp-2 flex-1">{{ post.data.teaser or post.templateContent | striptags | truncate(120) }}</p>
    <a href="{{ post.url }}" class="mt-4 inline-flex items-center gap-1 text-terra font-semibold text-sm hover:gap-2 transition-all duration-200">
      Weiterlesen
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
      </svg>
    </a>
  </div>
</article>
