<header class="sticky top-0 z-50 bg-sand/90 backdrop-blur-md border-b border-amber/40 shadow-sm">
  <div class="container-default">
    <div class="flex items-center justify-between h-16">

      <!-- Logo / Brand -->
      <a href="/" class="flex items-center gap-3 group no-underline">
        <img
          src="/assets/images/logo.svg"
          alt="Logo Förderverein CJD Kita Thorrfalken"
          class="w-20 h-20 transition-transform duration-300 group-hover:scale-110"
          onerror="this.style.display='none'"
        />
        <div class="leading-tight">
          <span class="block font-bold text-brown text-sm md:text-base">Förderverein der</span>
          <span class="block font-bold text-brown text-sm md:text-base">CJD Kita Thorrfalken e.V.</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-6" aria-label="Hauptnavigation">
        <a href="/"            class="nav-link {% if page.url == '/' %}active{% endif %}">Start</a>
        <a href="/ueber-uns/" class="nav-link {% if '/ueber-uns' in page.url %}active{% endif %}">Über uns</a>
        <a href="/projekte/"  class="nav-link {% if '/projekte' in page.url %}active{% endif %}">Projekte</a>
        <a href="/spenden/"   class="nav-link {% if '/spenden' in page.url %}active{% endif %}">Spenden</a>
        <a href="/kontakt/"   class="nav-link {% if '/kontakt' in page.url %}active{% endif %}">Kontakt</a>
        <a href="/downloads/" class="nav-link {% if '/downloads' in page.url %}active{% endif %}">Downloads</a>
      </nav>

      <!-- Right Actions: Heart + Burger -->
      <div class="flex items-center gap-2">
        <!-- Donate Heart Button -->
        <a href="/spenden/" class="btn-heart" aria-label="Jetzt spenden" title="Jetzt spenden">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
          </svg>
        </a>

        <!-- Burger Menu (mobile) -->
        <button
          id="burger-btn"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Menü öffnen"
          class="md:hidden flex flex-col gap-1.5 p-2 rounded-xl hover:bg-amber/30 transition-colors duration-200"
        >
          <span class="burger-line"></span>
          <span class="burger-line"></span>
          <span class="burger-line"></span>
        </button>
      </div>

    </div><!-- end flex row -->

    <!-- Mobile Menu Panel -->
    <nav id="mobile-menu" aria-label="Mobile Navigation">
      <div class="flex flex-col gap-1 pb-4 pt-2">
        <a href="/"            class="nav-link px-3 py-2 rounded-xl hover:bg-amber/20 {% if page.url == '/' %}active{% endif %}">Start</a>
        <a href="/ueber-uns/" class="nav-link px-3 py-2 rounded-xl hover:bg-amber/20 {% if '/ueber-uns' in page.url %}active{% endif %}">Über uns</a>
        <a href="/projekte/"  class="nav-link px-3 py-2 rounded-xl hover:bg-amber/20 {% if '/projekte' in page.url %}active{% endif %}">Projekte</a>
        <a href="/spenden/"   class="nav-link px-3 py-2 rounded-xl hover:bg-amber/20 {% if '/spenden' in page.url %}active{% endif %}">Spenden</a>
        <a href="/kontakt/"   class="nav-link px-3 py-2 rounded-xl hover:bg-amber/20 {% if '/kontakt' in page.url %}active{% endif %}">Kontakt</a>
        <a href="/downloads/" class="nav-link px-3 py-2 rounded-xl hover:bg-amber/20 {% if '/downloads' in page.url %}active{% endif %}">Downloads</a>
      </div>
    </nav>
  </div>
</header>
