---
layout: layouts/base.njk
tags: projekte
---

<!-- Single Project -->
<section class="bg-gradient-to-br from-sand via-amber/10 to-cta/5 pt-16 pb-10">
  <div class="container-default max-w-3xl">
    <a href="/projekte/" class="inline-flex items-center gap-2 text-terra font-semibold text-sm mb-8 hover:gap-3 transition-all duration-200">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/>
      </svg>
      Alle Projekte
    </a>

    <time class="text-xs font-semibold text-terra uppercase tracking-wider mb-3 block"
          datetime="{{ page.date | dateISO }}">
      {{ page.date | dateFormat }}
    </time>
    <h1 class="mb-6">{{ title }}</h1>
  </div>
</section>

<section class="section bg-sand pt-0">
  <div class="container-default max-w-3xl">

    <!-- Hero image -->
    {% if bild %}
      <img
        src="{{ bild }}"
        alt="{{ title }}"
        class="w-full h-64 md:h-96 object-cover rounded-3xl shadow-xl mb-10"
        onerror="this.src='/assets/images/logo.svg'; this.classList.add('object-contain','p-16','bg-amber/20');"
      />
    {% else %}
      <div class="w-full h-48 bg-amber/20 rounded-3xl flex items-center justify-center mb-10 shadow-lg">
        <img src="/assets/images/logo.svg" alt="Platzhalter" class="w-28 h-28 opacity-50" />
      </div>
    {% endif %}

    <!-- Content -->
    <article class="prose prose-thorrfalken max-w-none">
      {{ content | safe }}
    </article>

    <!-- Back link -->
    <div class="mt-12 pt-8 border-t border-amber/40">
      <a href="/projekte/" class="btn-secondary">← Zurück zu den Projekten</a>
    </div>

  </div>
</section>
